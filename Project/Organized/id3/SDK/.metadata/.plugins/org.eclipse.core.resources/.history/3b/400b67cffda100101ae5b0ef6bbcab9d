void delay_ns(u64 ns) {
    XTime t1, t2;
    u64 cycles = (COUNTS_PER_SECOND * ns) / 1000000000ULL;  // ns  cycles
    XTime_GetTime(&t1);
    do {
        XTime_GetTime(&t2);
    } while ((t2 - t1) < cycles);
}


